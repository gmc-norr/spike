+            let s = m.start.saturating_sub(lead);
+            reference.fetch_sequence(chrom, s, s + 161).unwrap_or_default()
+        } else {
+            let e = m.start + ref_len + trail;
+            let mut v = reference.fetch_sequence(chrom, e.saturating_sub(161), e).unwrap_or_default();
