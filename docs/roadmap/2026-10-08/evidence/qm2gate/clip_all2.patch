+/// Experiment switches (throwaway): SPIKE_QX bits, read once.
+fn qx() -> u32 {
+    static QX: std::sync::OnceLock<u32> = std::sync::OnceLock::new();
+    *QX.get_or_init(|| std::env::var("SPIKE_QX").ok().and_then(|v| v.parse().ok()).unwrap_or(0))
